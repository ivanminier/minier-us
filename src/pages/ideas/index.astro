---
import { formatNoteDate, getPublishedNotes } from "../../data/notes";
import Base from "../../layouts/Base.astro";
const notes = await getPublishedNotes();
---

<Base
  title="Notes — Ivan Minier"
  theme="notes"
  description="Project notes by Ivan Minier on software, interface design, and housing feasibility."
>
  <section class="page-hero wrap-wide notes-index">
    <p class="eyebrow">From the work</p>
    <h1>Notes</h1>
    <p class="lede">The decisions I made while building apps and developing a housing proposal. Dates mark the work each note covers.</p>
  </section>
  <section class="wrap-wide notes-index section" style="padding-top:0">
    {notes.map((note) => (
      <article class="note-entry">
        <time datetime={note.data.date}>
          {formatNoteDate(note.data.date)}
        </time>
        <div>
          <h2>
            <a href={`/ideas/${note.id}`}>{note.data.title}</a>
          </h2>
          <p>{note.data.summary}</p>
        </div>
      </article>
    ))}
  </section>
</Base>
