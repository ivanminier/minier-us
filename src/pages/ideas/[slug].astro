---
import { render } from "astro:content";
import { formatNoteDate, getPublishedNotes } from "../../data/notes";
import { laundryLink } from "../../data/laundrylink";
import { getProject } from "../../data/projects";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const ideas = await getPublishedNotes();
  return ideas.map((idea) => ({
    params: { slug: idea.id },
    props: { idea },
  }));
}

const { idea } = Astro.props;
const { Content } = await render(idea);
const project = getProject(idea.data.project)!;
---

<Base
  title={`${idea.data.title} — Ivan Minier`}
  description={idea.data.summary}
  type="article"
  image={project.slug === "uvm-laundrylink" ? laundryLink.socialImage : undefined}
  imageAlt={project.slug === "uvm-laundrylink" ? laundryLink.socialImageAlt : undefined}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "Article",
    headline: idea.data.title,
    description: idea.data.summary,
    ...(project.slug === "uvm-laundrylink" && { datePublished: idea.data.date }),
    author: { "@type": "Person", name: "Ivan Minier", url: "https://minier.us/" },
    mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  }}
  theme="notes"
>
  <article class="reading-room">
    <p class="eyebrow">
      <a href="/ideas">Notes</a> /{" "}
      <time datetime={idea.data.date}>
        {formatNoteDate(idea.data.date)}
      </time>
    </p>
    <h1>{idea.data.title}</h1>
    <p class="lede">{idea.data.summary}</p>
    <Content />
    <footer class="reading-footer">
      <a href="/ideas">All notes</a>
      <a href={project.href}>View {project.shortName}</a>
    </footer>
  </article>
</Base>
