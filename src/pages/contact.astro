---
import Base from "../layouts/Base.astro";
---

<Base
  title="Contact — Ivan Minier"
  theme="contact"
  description="Get in touch with Ivan Minier at ivan@minier.us."
>
  <section class="contact-opening wrap-wide">
    <p class="eyebrow">Contact</p>
    <h1>
      Let's start
      <br />a conversation.
    </h1>
    <p class="lede">
      For a question about my work, an idea to share, or simply to say hello.
    </p>
    <div class="contact-email">
      <a href="mailto:ivan@minier.us">ivan@minier.us</a>
      <button class="btn btn-ghost" type="button" data-copy>
        Copy email
      </button>
    </div>
    <p
      class="copy-feedback"
      role="status"
      aria-live="polite"
      data-copy-feedback
    ></p>
    <div class="contact-socials">
      <a href="https://www.linkedin.com/in/ivanminier">LinkedIn ↗</a>
      <a href="https://github.com/ivanminier">GitHub ↗</a>
    </div>
  </section>
  <script>
    document
      .querySelector("[data-copy]")
      ?.addEventListener("click", async () => {
        const status = document.querySelector("[data-copy-feedback]")!;
        try {
          await navigator.clipboard.writeText("ivan@minier.us");
          status.textContent = "Email address copied.";
        } catch {
          status.textContent =
            "Copy unavailable. Select ivan@minier.us above, or open the email link.";
        }
      });
  </script>
</Base>
