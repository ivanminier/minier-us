---
import Base from "../layouts/Base.astro";
import { getProject } from "../data/projects";
const products = ["modeboard", "rental-record", "lineup"].map((s) =>
  getProject(s)!,
);
---

<Base
  title="Tideframe Labs — Ivan Minier"
  theme="studio"
  description="The independent software studio founded by Ivan Minier. Product direction, interface design, development, and the work around a release."
>
  <section class="studio-opening wrap-wide">
    <div>
      <img
        class="studio-mark"
        src="/media/tideframe/mark-mono.svg"
        width="5096"
        height="5096"
        alt="Tideframe Labs"
      />
      <p class="eyebrow">The studio chapter</p>
      <h1>Tideframe Labs</h1>
      <p class="lede">
        Independent software.
        <br />
        Built in Vermont.
      </p>
    </div>
    <div>
      <p>
        I founded Tideframe Labs to bring focused products to Apple platforms.
        The work spans the product itself and the less visible pieces that help
        someone install, understand, and use it.
      </p>
      <div class="studio-responsibilities">
        <p class="eyebrow">My role / Founder & product builder</p>
        <p>
          Product direction, interface design, development, release operations,
          documentation, and customer support. AI-assisted development is part
          of the process.
        </p>
      </div>
      <a class="text-link" href="https://tideframelabs.com">
        Visit Tideframe Labs ↗
      </a>
    </div>
  </section>
  <section class="section wrap-wide studio-products">
    {products.map((p) => (
      <article class="studio-product">
        <img
          src={p.icon}
          width="256"
          height="256"
          alt={`${p.shortName} app icon`}
        />
        <p class="status">{p.statusLabel}</p>
        <h2>{p.shortName}</h2>
        <p>
          {p.slug === "modeboard"
            ? "Workspace profiles and supported settings for the Mac."
            : p.slug === "lineup"
              ? "An Apple-native organizer and player for user-supplied television sources."
              : "Guided room records, photographs, observations, and readable reports."}
        </p>
        <a class="text-link" href={p.href}>
          My work on {p.shortName} ↗
        </a>
      </article>
    ))}
  </section>
  <section class="section wrap-wide">
    <h2>
      The product home
      <br />
      lives at Tideframe.
    </h2>
    <p style="max-width:55ch">
      Downloads, purchases, current product information, support, and each
      product's privacy and legal policies belong on the studio site.
    </p>
    <a class="btn" href="https://tideframelabs.com">
      Explore the studio ↗
    </a>
  </section>
</Base>
