---
import Base from "../layouts/Base.astro";
import WorkCard from "../components/WorkCard.astro";
import ProjectMedia from "../components/ProjectMedia.astro";
import lineup from "../data/lineup-media.json";
import { getProject } from "../data/projects";
const mode = getProject("modeboard")!;
---

<Base>
  <section class="home-opening wrap-wide">
    <div class="home-intro">
      <p class="eyebrow">Ivan Minier · Vermont</p>
      <h1>
        Communication,
        <br class="desktop-break" /> design, and things that <em>work.</em>
      </h1>
      <p class="lede">
        I'm a Public Communication student at UVM and the founder of{" "}
        <a href="/tideframe">Tideframe Labs</a>. I build software, develop
        public-facing ideas, and make complicated information easier to use.
      </p>
      <a class="text-link" href="/work">
        Explore my work <span>↗</span>
      </a>
    </div>
    <div class="home-composition">
      <div class="composition-label">
        <span>Independent work / 2025–26</span>
        <span>Made with purpose</span>
      </div>
      <a href="/work/lineup" class="composition-tv">
        <ProjectMedia
          media={lineup.tv}
          zoom={false}
          eager
          sizes="(max-width:700px) 90vw, 47vw"
        />
      </a>
      <a class="composition-mac" href="/work/modeboard">
        <ProjectMedia
          media={mode.hero}
          zoom={false}
          eager
          sizes="(max-width:700px) 68vw, 34vw"
        />
      </a>
      <div class="composition-note">
        <span class="tiny-dot"></span> Software for everyday life.
        <small>Lineup (coming soon) + Modeboard</small>
      </div>
    </div>
  </section>
  <section class="section wrap-wide">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2>Ideas made useful.</h2>
      </div>
      <a class="text-link" href="/work">
        All work ↗
      </a>
    </div>
    <div class="selected-grid">
      <WorkCard slug="rental-record" number="01" featured />
      <WorkCard slug="lineup" number="02" />
      <WorkCard slug="trinity-redistricting" number="03" />
    </div>
    <p class="caption">
      Lineup screens show an original fictional demo. No channels or
      subscriptions are included.
    </p>
  </section>
  <section class="section experience-band">
    <div class="wrap-wide experience-summary">
      <div>
        <p class="eyebrow">Beyond the screen</p>
        <h2>
          People are part
          <br />
          of the work.
        </h2>
      </div>
      <div>
        <p>
          Campus marketing, conference hospitality, and Public Communication
          studies shape how I think about an audience—and what makes information
          useful to them.
        </p>
        <div class="mini-timeline">
          <p>
            <strong>University of Vermont</strong>
            <span>Public Communication · Expected May 2028</span>
          </p>
          <p>
            <strong>Campus marketing leadership</strong>
            <span>Accounting Club & Redstone Hall Council</span>
          </p>
          <p>
            <strong>Summer Conference Assistant</strong>
            <span>UVM University Events Services · Summer 2025</span>
          </p>
        </div>
        <a class="text-link" href="/resume">
          View résumé ↗
        </a>
      </div>
    </div>
  </section>
  <section class="section wrap-wide home-notes">
    <p class="eyebrow">A little more context</p>
    <h2>Notes from the work.</h2>
    <a href="/ideas/messy-catalogs">
      The catalog is the product <span>14 August 2026 ↗</span>
    </a>
    <a href="/ideas/housing-as-a-system">
      Housing is more than a rendering <span>1 May 2026 ↗</span>
    </a>
  </section>
  <section class="section wrap-wide home-contact">
    <p class="eyebrow">Get in touch</p>
    <h2>
      Good work starts
      <br />
      with a conversation.
    </h2>
    <a class="text-link" href="mailto:ivan@minier.us">
      ivan@minier.us ↗
    </a>
  </section>
</Base>
