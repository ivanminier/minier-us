---
import Base from "../layouts/Base.astro";
import {
  education,
  experience,
  capabilities,
  laundryDates,
} from "../data/experience";
import { laundryStatus } from "../data/projects";
---

<Base
  title="Résumé — Ivan Minier"
  theme="resume"
  description="Education, product work, employment, campus leadership, and capabilities of Ivan Minier."
>
  <article class="resume-page wrap-wide">
    <header class="resume-heading">
      <div>
        <p class="eyebrow">Résumé</p>
        <h1>Ivan Minier</h1>
        <p>
          Public Communication student · Product builder · Founder, Tideframe
          Labs
        </p>
        <p>
          <a href="mailto:ivan@minier.us">ivan@minier.us</a> · Vermont
          <span class="print-contact">
            minier.us · linkedin.com/in/ivanminier · github.com/ivanminier
          </span>
        </p>
      </div>
      <div class="actions">
        <button class="btn" type="button" data-print>
          Print / Save PDF
        </button>
        <a class="btn btn-ghost" href="/ivan-minier-resume.pdf" download>
          Download PDF ↓
        </a>
      </div>
    </header>
    <div class="resume-columns">
      <div>
        <section class="resume-section">
          <h2>Education</h2>
          <div class="resume-entry">
            <h3>{education.school}</h3>
            <p>
              {education.program}
              <br />
              {education.department}
            </p>
            <span class="date">
              {education.date} · {education.location}
            </span>
          </div>
        </section>
        <section class="resume-section">
          <h2>Founder & product work</h2>
          <div class="resume-entry">
            <h3>Tideframe Labs — Founder & product builder</h3>
            <p>
              Independent software studio in Vermont. Product direction,
              interface design, development, release operations, documentation,
              and support; includes AI-assisted development.
            </p>
            <ul>
              <li>
                <strong>Modeboard:</strong> released Mac utility for workspace
                profiles, supported settings, and restore workflows.
              </li>
              <li>
                <strong>Rental Record:</strong> released app for guided
                condition records, photographs, notes, and reports on iPhone,
                iPad, and Mac.
              </li>
              <li>
                <strong>Lineup:</strong> forthcoming television player and
                organizer for user-supplied sources on iPhone, iPad, and Apple
                TV.
              </li>
            </ul>
          </div>
        </section>
        <section class="resume-section">
          <h2>Employment</h2>
          {experience
            .filter((x) => x.group === "Employment")
            .map((x) => (
              <div class="resume-entry">
                <h3>{x.role}</h3>
                <p>{x.organization}</p>
                <span class="date">{x.date}</span>
                <ul>
                  {x.details.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </div>
            ))}
        </section>
        <section class="resume-section">
          <h2>Campus leadership</h2>
          {experience
            .filter((x) => x.group === "Leadership")
            .map((x) => (
              <div class="resume-entry">
                <h3>
                  {x.role} — {x.organization}
                </h3>
                <span class="date">{x.date}</span>
                <ul>
                  {x.details.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </div>
            ))}
        </section>
        <section class="resume-section">
          <h2>Selected independent projects</h2>
          <div class="resume-entry">
            <h3>Trinity Redistricting</h3>
            <p>
              Independent student housing concept: research, planning, writing,
              and public documentation. Not an official UVM or City plan.
            </p>
          </div>
          <div class="resume-entry">
            <h3>UVM LaundryLink — Student prototype</h3>
            <span class="date">{laundryDates}</span>
            <p>
              Room discovery, favorites, dark mode, and SMS notifications;
              AI-assisted front-end development. {laundryStatus.label} while its
              server is offline.
            </p>
          </div>
        </section>
      </div>
      <aside>
        <section class="resume-section">
          <h2>Capabilities</h2>
          {capabilities.map((x) => (
            <div class="resume-entry">
              <h3>{x.title}</h3>
              <p>{x.text}</p>
            </div>
          ))}
        </section>
        <section class="resume-section">
          <h2>Additional experience</h2>
          {experience
            .filter((x) => x.group === "Additional experience")
            .map((x) => (
              <div class="resume-entry">
                <h3>
                  {x.role} — {x.organization}
                </h3>
                <span class="date">{x.date}</span>
                <p>{x.details.join(" ")}</p>
              </div>
            ))}
        </section>
      </aside>
    </div>
    <p class="resume-note">
      Ongoing campus and research-participant dates reflect the supplied résumé,
      reviewed October 2026.
    </p>
  </article>
  <script>
    document
      .querySelector("[data-print]")
      ?.addEventListener("click", () => window.print());
  </script>
</Base>
