---
import Base from "../../layouts/Base.astro";
import NextProject from "../../components/NextProject.astro";
import ProjectMedia from "../../components/ProjectMedia.astro";
import { getProject } from "../../data/projects";
import { laundryLink as product } from "../../data/laundrylink";
import media from "../../data/laundrylink-media.json";
import { getPublishedNotes } from "../../data/notes";

const project = getProject("uvm-laundrylink")!;
const notes = (await getPublishedNotes()).filter(({ data }) => data.project === project.slug);
const [visit, ...resources] = project.links;
const { coverage, release } = product;
---

<Base
  title="UVM LaundryLink — Ivan Minier"
  theme="campus"
  image={product.socialImage}
  imageAlt={product.socialImageAlt}
  description={project.summary}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: project.name,
    description: project.summary,
    url: product.url,
    mainEntityOfPage: "https://minier.us/work/uvm-laundrylink/",
    applicationCategory: "UtilitiesApplication",
    operatingSystem: "Web browser",
    browserRequirements: "JavaScript for the interactive room tracker",
    creator: { "@type": "Person", name: "Ivan Minier", url: "https://minier.us/" },
    isAccessibleForFree: true,
  }}
>
  <section class="laundry-opening wrap-wide">
    <div class="laundry-heading">
      <div>
        <img class="laundry-icon" src={project.icon} width="56" height="56" alt="" />
        <p class="eyebrow">{project.studioLabel}</p>
        <h1>{project.name}</h1>
        <p class="laundry-tagline">Know before you go.</p>
      </div>
      <div class="laundry-intro">
        <p class="lede">{project.summary}</p>
        <a class="btn" href={visit.href}>{visit.label} <span aria-hidden="true">↗</span></a>
        <p class="role-line">{project.year} · {project.statusLabel}</p>
        <p class="role-line">{project.role}</p>
      </div>
    </div>
    <figure class="laundry-hero">
      <ProjectMedia media={project.hero} eager sizes="(max-width: 700px) 92vw, (max-width: 1300px) 90vw, 1200px" />
      <figcaption>Production LaundryLink on desktop and mobile, captured November 27, 2026.</figcaption>
    </figure>
    <dl class="laundry-facts">
      <div><dt>Supported laundry rooms</dt><dd>{coverage.rooms}</dd></div>
      <div><dt>Residence hall buildings or complexes</dt><dd>{coverage.hallGroups}</dd></div>
      <div><dt>Campus areas</dt><dd>{coverage.areas}</dd></div>
      <div><dt>Installable web app</dt><dd>Free to use</dd></div>
    </dl>
  </section>

  <section class="section wrap-wide laundry-story" aria-labelledby="room-heading">
    <div>
      <h2 id="room-heading">Get to the room you use.</h2>
      <p>{project.problem}</p>
      <p>{project.approach} The directory follows familiar campus names and gets more specific where it needs to, down to an individual tower, floor, or room. Search understands common shorthand such as CCRH, and campus shortcuts and the room picker save a trip through the directory. Hall guides list indoor locations and equipment counts on record, with links to the live tracker and the provider’s room view.</p>
      <p>Favorites bring frequently used rooms and their availability summaries together. The web app also offers a last-room startup preference, light and dark appearances, and Home Screen installation.</p>
    </div>
    <div class="laundry-pair">
      <figure class="laundry-phone">
        <ProjectMedia media={media.picker} sizes="(max-width: 480px) 85vw, 245px" />
        <figcaption>{media.picker.caption}</figcaption>
      </figure>
      <figure class="laundry-phone">
        <ProjectMedia media={media.favorites} sizes="(max-width: 480px) 85vw, 245px" />
        <figcaption>{media.favorites.caption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section wrap-wide laundry-reading" aria-labelledby="availability-heading">
    <div class="laundry-story-copy">
      <h2 id="availability-heading">What’s free now? When is it usually quiet?</h2>
      <p>The tracker distinguishes available, running, finished, out-of-order, and offline machines. Running cycles show time remaining when the provider reports it. Room Layout shows machine numbers and current statuses, and Peak Times shows historical usage and a quieter daytime window where the history supports one.</p>
      <p>When waiting makes more sense than making a trip, students can set browser push alerts for cycle completion or the next available washer or dryer and manage them in My Laundry. A running cycle with a finish estimate can also offer a calendar reminder. Automatic Laundry handles text and email alerts through its embedded panel, with a link to open the provider directly.</p>
    </div>
    <figure class="laundry-wide">
      <ProjectMedia media={media.peak} sizes="(max-width: 700px) 92vw, 1050px" />
      <figcaption>{media.peak.caption}</figcaption>
    </figure>
  </section>

  <section class="section wrap-wide laundry-story" aria-labelledby="reliability-heading">
    <div>
      <h2 id="reliability-heading">Make the age of the data visible.</h2>
      <p>{project.reasoning} The app can reopen offline after an earlier visit. If every machine reports offline, the tracker marks availability as unavailable and shows when it checked. The same view links to LaundryConnect and LaundryLink’s service checks.</p>
      <p>I led the product, interface, and release work with AI-assisted development. The React app reads provider machine metadata and status from {coverage.feeds} distinct feeds. Cloudflare Pages serves the public site, and a separate Cloudflare Worker handles browser push. Scheduled jobs refresh historical usage and service snapshots, with automated regression, deployment, and public health checks.</p>
      <p>The interactive app shares its room mapping with plain HTML campus and hall pages, so a student can land on the right page directly from search. Keyboard access, focus behavior, and clear status labels are part of that experience. Aggregate analytics count product activity and referrals with privacy controls.</p>
    </div>
    <figure class="laundry-phone">
      <ProjectMedia media={media.alerts} sizes="(max-width: 390px) 85vw, 320px" />
      <figcaption>{media.alerts.caption}</figcaption>
    </figure>
  </section>

  <section class="section wrap-wide laundry-release" aria-labelledby="release-heading">
    <h2 id="release-heading">A maintained campus utility.</h2>
    <p>LaundryLink is deployed and feature-complete. I maintain it as an independent student project. Its coverage figures describe the room directory and public site.</p>
    <p>The <a href={release.workflow}>{release.date} release checks</a> passed {release.appTests} app tests and {release.workerTests} Worker tests. The production review covered {coverage.publicPages} canonical public pages and all {coverage.rooms} room deep links. The service page reports the latest automated feed and push configuration checks. Browser push delivery depends on the browser, device settings, and room feed.</p>
  </section>

  <section class="section wrap-wide laundry-notes" aria-labelledby="notes-heading">
    <h2 id="notes-heading">Notes from LaundryLink</h2>
    <ul>
      {notes.map((note) => (
        <li>
          <a href={`/ideas/${note.id}/`}>{note.data.title}</a>
          <p>{note.data.summary}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="section wrap-wide case-ending">
    <div>
      <h2>Check your laundry room.</h2>
      <a class="btn" href={visit.href}>{visit.label} <span aria-hidden="true">↗</span></a>
      <ul class="laundry-resources">
        {resources.map((link) => <li><a href={link.href}>{link.label} <span aria-hidden="true">↗</span></a></li>)}
      </ul>
      <p class="caption">Independent of the University of Vermont and Automatic Laundry.</p>
    </div>
    <NextProject slug={project.slug} />
  </section>
</Base>

<style>
  .laundry-opening { padding-top: clamp(2.5rem, 6vw, 5rem); }
  .laundry-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 2rem 5%;
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .laundry-heading h1 { font-size: clamp(2.4rem, 5.5vw, 5.4rem); }
  .laundry-icon { border-radius: 13px; margin-bottom: 1rem; }
  .laundry-tagline {
    font-family: var(--display);
    font-size: clamp(1.25rem, 2.6vw, 2.3rem);
    color: var(--accent);
    margin: .55rem 0 0;
  }
  .laundry-intro .lede { font-size: 1.08rem; margin: 0 0 1rem; }
  .laundry-intro .btn { margin-bottom: .85rem; }
  .laundry-intro .role-line { margin: .15rem 0; }
  .laundry-hero, .laundry-wide, .laundry-phone { margin: 0; min-width: 0; }
  .laundry-hero :global(img), .laundry-wide :global(img) { width: 100%; border-radius: 1rem; }
  .laundry-facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 1.5rem 0 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--line);
  }
  .laundry-facts div { display: flex; flex-direction: column-reverse; justify-content: flex-end; }
  .laundry-facts dt { color: var(--ink); font-size: .88rem; }
  .laundry-facts dd { margin: 0; font-size: clamp(1.25rem, 2.5vw, 2rem); font-weight: 600; }
  .laundry-story {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr);
    gap: 2rem 8%;
    align-items: center;
    border-bottom: 1px solid var(--line);
  }
  .laundry-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: clamp(.75rem, 2vw, 1.4rem);
  }
  .laundry-phone { width: min(100%, 320px); justify-self: center; }
  .laundry-pair .laundry-phone { width: min(100%, 245px); }
  .laundry-phone :global(img) { border-radius: 1.25rem; border: 2px solid #1b2922; box-shadow: 0 14px 36px #06180e25; }
  .laundry-reading { border-bottom: 1px solid var(--line); }
  .laundry-story-copy { max-width: 67ch; margin-bottom: 1.75rem; }
  .laundry-release p { max-width: 68ch; }
  .laundry-notes { border-top: 1px solid var(--line); }
  .laundry-notes ul, .laundry-resources { list-style: none; padding: 0; }
  .laundry-notes ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .laundry-notes li { border-top: 1px solid var(--line); padding-top: 1rem; }
  .laundry-notes li a { font-weight: 700; }
  .laundry-notes li p { margin: .45rem 0 0; font-size: .92rem; }
  .laundry-resources { display: flex; flex-wrap: wrap; gap: .6rem 1.25rem; }
  @media (max-width: 900px) {
    .laundry-story { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 700px) {
    .laundry-heading, .laundry-notes ul { grid-template-columns: minmax(0, 1fr); }
    .laundry-heading { gap: 1.1rem; }
    .laundry-heading h1 { margin-bottom: .65rem; }
    .laundry-heading .eyebrow { margin-bottom: .75rem; }
    .laundry-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 480px) {
    .laundry-pair { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .laundry-pair .laundry-phone { width: min(100%, 290px); }
  }
</style>
