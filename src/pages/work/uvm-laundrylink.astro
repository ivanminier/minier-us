---
import Base from '../../layouts/Base.astro';
import NextProject from '../../components/NextProject.astro';
import ProjectFacts from '../../components/ProjectFacts.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import { getProject } from '../../data/projects';
import { site } from '../../data/site';

const project = getProject('uvm-laundrylink')!;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: project.name,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web',
  url: 'https://uvmlaundry.com',
  description: project.summary,
  author: { '@type': 'Person', name: 'Ivan Minier', url: site.url },
};
---

<Base title={`${project.name} — Ivan Minier`} description={project.summary} jsonLd={jsonLd} image="/media/og/laundrylink.png">
  <section class="case-hero">
    <div class="wrap">
      <div class="meta-row">
        <span class="badge">{project.statusLabel}</span>
        <span>By Ivan Minier</span>
        <span>{project.year}</span>
      </div>
      <h1>{project.oneLiner}</h1>
      <p class="lede">{project.summary}</p>
      <ProjectFacts project={project} />
      <div class="actions">
        <a class="btn" href="https://uvmlaundry.com" rel="noopener">Open LaundryLink ↗</a>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap" style="max-width:420px;">
      <div class="device-phone">
        <ProjectMedia media={project.hero} eager />
      </div>
      <p class="caption">Live room data depends on the campus source. This is the actual product interface.</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap prose">
      <h2>The problem</h2>
      <p>{project.problem}</p>
      <h2>The approach</h2>
      <p>{project.approach}</p>
      <h2>What it does</h2>
      <div class="grid-2">
        {project.capabilities.map((item) => (
          <article class="card">
            <strong>{item.title}</strong>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
      <h2>Why this still belongs here</h2>
      <p>{project.reasoning}</p>
      <p>
        LaundryLink is an independent student project. It is not an official University of Vermont product.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap">
      <NextProject slug={project.slug} />
    </div>
  </section>
</Base>
