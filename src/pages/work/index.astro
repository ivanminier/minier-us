---
import Base from '../../layouts/Base.astro';
import { featuredProjects } from '../../data/projects';

const lineup = featuredProjects[0];
const rental = featuredProjects[1];
const modeboard = featuredProjects[2];
const trinity = featuredProjects[3];
const laundry = featuredProjects[4];
---

<Base
  title="Work — Ivan Minier"
  description="Selected work by Ivan Minier: Lineup, Tideframe Rental Record, Modeboard, Trinity Redistricting, and UVM LaundryLink."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">Work</p>
      <h1>Selected projects</h1>
      <p class="lede">
        Tideframe products and independent projects, in the order they should be read.
      </p>
    </div>
  </section>
  <section class="section" style="padding-top:0;">
    <div class="wrap-wide work-index">
      <a class="work-feature" href={lineup.href}>
        <div class="work-copy">
          <div class="meta-row">
            <span class="badge">{lineup.statusLabel}</span>
            <span>{lineup.studioLabel}</span>
          </div>
          <h2>{lineup.name}</h2>
          <p>{lineup.oneLiner}</p>
          <div class="platforms">
            {lineup.platforms.map((item) => <span>{item}</span>)}
            {lineup.platformsPlanned && <span class="planned">{lineup.platformsPlanned}</span>}
          </div>
        </div>
        <div class="cinematic">
          <div class="device-phone">
            <img src={lineup.hero.src} srcset={lineup.hero.srcset} sizes="360px" width={lineup.hero.width} height={lineup.hero.height} alt={lineup.hero.alt} />
          </div>
        </div>
      </a>

      <a class="work-feature reverse" href={rental.href}>
        <div class="work-copy">
          <div class="meta-row">
            <span class="badge">{rental.statusLabel}</span>
            <span>{rental.studioLabel}</span>
          </div>
          <h2>{rental.name}</h2>
          <p>{rental.oneLiner}</p>
          <div class="platforms">{rental.platforms.map((item) => <span>{item}</span>)}</div>
        </div>
        <div class="devices-pair">
          <div class="device-phone">
            <img src={rental.hero.src} srcset={rental.hero.srcset} sizes="220px" width={rental.hero.width} height={rental.hero.height} alt={rental.hero.alt} />
          </div>
          <div class="shot">
            <img
              src={rental.devices!.desktop!.src}
              srcset={rental.devices!.desktop!.srcset}
              sizes="(max-width: 900px) 92vw, 34vw"
              width={rental.devices!.desktop!.width}
              height={rental.devices!.desktop!.height}
              alt=""
            />
          </div>
        </div>
      </a>

      <a class="work-feature" href={modeboard.href}>
        <div class="work-copy">
          <div class="meta-row">
            <span class="badge">{modeboard.statusLabel}</span>
            <span>{modeboard.studioLabel}</span>
          </div>
          <h2>{modeboard.name}</h2>
          <p>{modeboard.oneLiner}</p>
        </div>
        <div class="shot">
          <img src={modeboard.hero.src} srcset={modeboard.hero.srcset} sizes="(max-width: 900px) 92vw, 52vw" width={modeboard.hero.width} height={modeboard.hero.height} alt={modeboard.hero.alt} />
        </div>
      </a>

      <a class="work-feature reverse" href={trinity.href}>
        <div class="work-copy">
          <div class="meta-row">
            <span class="badge">{trinity.statusLabel}</span>
            <span>{trinity.studioLabel}</span>
          </div>
          <h2>{trinity.name}</h2>
          <p>{trinity.oneLiner}</p>
        </div>
        <div class="editorial">
          <img src={trinity.hero.src} srcset={trinity.hero.srcset} sizes="(max-width: 900px) 92vw, 52vw" width={trinity.hero.width} height={trinity.hero.height} alt={trinity.hero.alt} />
        </div>
      </a>

      <a class="work-feature" href={laundry.href}>
        <div class="work-copy">
          <div class="meta-row">
            <span class="badge">{laundry.statusLabel}</span>
            <span>{laundry.studioLabel}</span>
          </div>
          <h2>{laundry.name}</h2>
          <p>{laundry.oneLiner}</p>
        </div>
        <div class="mark-card">
          <img src={laundry.hero.src} srcset={laundry.hero.srcset} sizes="180px" width={laundry.hero.width} height={laundry.hero.height} alt={laundry.hero.alt} />
        </div>
      </a>
    </div>
  </section>
</Base>
