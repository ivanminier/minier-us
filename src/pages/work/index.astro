---
import Base from "../../layouts/Base.astro";
import WorkCard from "../../components/WorkCard.astro";
import { laundryStatus } from "../../data/projects";
---

<Base
  title="Work — Ivan Minier"
  theme="work"
  description="Housing and development studies, released software, a forthcoming television organizer, and independent campus projects by Ivan Minier."
>
  <section class="page-hero wrap-wide">
    <p class="eyebrow">Selected work / 2025–26</p>
    <h1>
      Built to be used.
      <br />
      Made to make sense.
    </h1>
    <p class="lede">
      A student housing proposal and its design studies, released software, and
      campus tools. Different formats, with a shared attention to the person
      using them.
    </p>
  </section>

  <section class="wrap-wide work-group" aria-labelledby="g-built">
    <div class="work-group-head">
      <h2 id="g-built">Built environment</h2>
      <p>
        Independent, concept-stage housing work: research, planning, original
        schematic floor plans, and development arithmetic. Not official UVM or
        City plans.
      </p>
    </div>
    <div class="work-index">
      <WorkCard slug="trinity-redistricting" number="01" featured />
    </div>
    <div class="st-next" style="margin-top:1.5rem">
      <a href="/studies"><strong>Trinity Residential Design Studies</strong><span>Suite and apartment plans, a typical-floor test fit, and whole-building capacity — November 2026</span></a>
      <a href="/studies/development-model"><strong>Trinity Rise development model</strong><span>Two scenarios, sensitivities, and a downloadable workbook</span></a>
      <a href="/portfolio/trinity"><strong>Trinity portfolio presentation</strong><span>A concise summary for admissions and internships, with PDF</span></a>
    </div>
  </section>

  <section class="wrap-wide work-group" aria-labelledby="g-software">
    <div class="work-group-head">
      <h2 id="g-software">Software & products</h2>
      <p>
        Apps I design, build, and ship through Tideframe Labs, my independent
        software studio, plus an earlier campus prototype.
      </p>
    </div>
    <div class="work-index">
      <WorkCard slug="lineup" number="02" featured />
      <WorkCard slug="rental-record" number="03" />
      <WorkCard slug="modeboard" number="04" />
    </div>
    <div class="laundry-small" style="margin-top:2rem">
      <img
        src="/media/laundrylink/logo.webp"
        width="512"
        height="512"
        alt="LaundryLink mark"
      />
      <div>
        <h3>UVM LaundryLink</h3>
        <p>Student prototype · {laundryStatus.label}</p>
      </div>
      <a class="text-link" href="/work/uvm-laundrylink">
        Read the case study ↗
      </a>
    </div>
  </section>

  <section class="wrap-wide work-group section" aria-labelledby="g-comm">
    <div class="work-group-head">
      <h2 id="g-comm">Communication & research</h2>
      <p>
        Writing and public documentation: the Trinity document packet and
        evidence ledger, and short notes on what the work taught me.
      </p>
    </div>
    <div class="st-next">
      <a href="https://trinityredistricting.com/documents.html"><strong>Trinity document packet ↗</strong><span>Proposal, memo, deck, and accessible companions</span></a>
      <a href="/ideas/housing-as-a-system"><strong>Housing is more than a rendering</strong><span>Note · May 2026</span></a>
      <a href="/ideas/messy-catalogs"><strong>The catalog is the product</strong><span>Note · August 2026</span></a>
    </div>
    <p class="caption">
      Lineup imagery uses an original fictional demo. No channels or
      subscriptions included. Trinity is an independent concept, not an approved
      university plan.
    </p>
  </section>
</Base>
