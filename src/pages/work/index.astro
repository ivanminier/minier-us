---
import Base from "../../layouts/Base.astro";
import WorkCard from "../../components/WorkCard.astro";
import { featuredProjects } from "../../data/projects";
---

<Base
  title="Work — Ivan Minier"
  theme="work"
  description="Housing and development studies, Apple apps, and independent campus projects by Ivan Minier."
>
  <section class="page-hero wrap-wide">
    <p class="eyebrow">Selected work / 2025–26</p>
    <h1>
      Built to be used.
      <br />
      Made to make sense.
    </h1>
    <p class="lede">
      A student housing proposal, released software, and
      campus tools. Different formats, with a shared attention to the person
      using them.
    </p>
  </section>

  <section class="wrap-wide work-group" aria-labelledby="g-built">
    <div class="work-group-head">
      <h2 id="g-built">Built environment</h2>
      <p>
        Independent, concept-stage housing work: research, planning, writing,
        and public documentation, with residential design studies in progress.
        Not official UVM or City plans.
      </p>
    </div>
    <div class="work-index">
      <WorkCard slug="trinity-redistricting" featured />
    </div>
    <div class="st-next" style="margin-top:1.5rem">
      <div class="st-card"><strong>In progress: residential design studies</strong><p>Room and suite layouts, building test fits, and exploratory development analysis extending the Trinity proposal. Not yet published; under review.</p></div>
    </div>
  </section>

  <section class="wrap-wide work-group" aria-labelledby="g-campus">
    <div class="work-group-head">
      <h2 id="g-campus">Independent campus software</h2>
      <p>A student-created utility for an everyday problem in UVM residence halls.</p>
    </div>
    <div class="work-index">
      <WorkCard slug="uvm-laundrylink" featured />
    </div>
  </section>

  <section class="wrap-wide work-group" aria-labelledby="g-software">
    <div class="work-group-head">
      <h2 id="g-software">Tideframe Labs</h2>
      <p>Apple apps I design, build, and ship through my independent software studio.</p>
    </div>
    <div class="work-index">
      {featuredProjects.filter((project) => project.studio === "tideframe").map((project) => (
        <WorkCard slug={project.slug} />
      ))}
    </div>
  </section>

  <section class="wrap-wide work-group section" aria-labelledby="g-comm">
    <div class="work-group-head">
      <h2 id="g-comm">Communication & research</h2>
      <p>
        Writing and public documentation: the Trinity document packet and
        evidence ledger, and short notes on what the work taught me.
      </p>
    </div>
    <div class="st-next">
      <a href="https://trinityredistricting.com/documents.html"><strong>Trinity document packet ↗</strong><span>Proposal, memo, deck, and accessible companions</span></a>
      <a href="/ideas"><strong>Notes from the work</strong><span>Design decisions behind the apps and Trinity</span></a>
    </div>
    <p class="caption">
      Lineup imagery uses an original fictional demo. No channels or
      subscriptions included. Trinity is an independent concept, not an approved
      university plan.
    </p>
  </section>
</Base>
