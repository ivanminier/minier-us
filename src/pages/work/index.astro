---
import Base from "../../layouts/Base.astro";
import WorkCard from "../../components/WorkCard.astro";
import { laundryStatus } from "../../data/projects";
---

<Base
  title="Work — Ivan Minier"
  theme="work"
  description="Released software, a forthcoming television organizer, and independent campus projects by Ivan Minier."
>
  <section class="page-hero wrap-wide">
    <p class="eyebrow">Selected work / 2025–26</p>
    <h1>
      Built to be used.
      <br />
      Made to make sense.
    </h1>
    <p class="lede">
      Software, documentation, and a student housing concept. Different formats,
      with a shared attention to the person using them.
    </p>
  </section>
  <section class="wrap-wide work-index">
    <WorkCard slug="lineup" number="01" featured />
    <WorkCard slug="rental-record" number="02" />
    <WorkCard slug="modeboard" number="03" />
    <WorkCard slug="trinity-redistricting" number="04" featured />
  </section>
  <section class="wrap-wide section">
    <div class="laundry-small">
      <img
        src="/media/laundrylink/logo.webp"
        width="512"
        height="512"
        alt="LaundryLink mark"
      />
      <div>
        <h3>UVM LaundryLink</h3>
        <p>Student prototype · {laundryStatus.label}</p>
      </div>
      <a class="text-link" href="/work/uvm-laundrylink">
        Read the case study ↗
      </a>
    </div>
    <p class="caption">
      Lineup imagery uses an original fictional demo. No channels or
      subscriptions included. Trinity is an independent concept, not an approved
      university plan.
    </p>
  </section>
</Base>
