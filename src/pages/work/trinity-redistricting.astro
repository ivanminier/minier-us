---
import Base from "../../layouts/Base.astro";
import ProjectMedia from "../../components/ProjectMedia.astro";
import NextProject from "../../components/NextProject.astro";
import Chip from "../../components/studies/Chip.astro";
import { getProject } from "../../data/projects";
import { tf, trinityRelease, trinityFigures as F, statusLabel, trinityPinned, trinityCeilingFt, trinityRiseStoryRange } from "../../data/trinity";
const p = getProject("trinity-redistricting")!;

const ledger = [
  ["peaks_beds", "Trinity Peaks (first- and second-year)"],
  ["rise_beds", "Trinity Rise (upperclass apartments)"],
  ["new_beds", "Combined new capacity"],
  ["replacement_beds", "Existing beds replaced (McAuley, Mercy, Back Five)"],
  ["net_new_beds", "Estimated net-new beds"],
  ["capital_range", "Illustrative district capital study range"],
  ["rise_height", "Trinity Rise height target"],
  ["zoning_current", "Adopted Trinity Campus overlay (as reported)"],
  ["pc_2022", "2022 Planning Commission recommendation"],
].map(([id, label]) => ({ ...tf(id), label }));
const kind = (s: string) => (s === "assumption" ? "assumption" : s === "calculated" ? "calculated" : s === "external" ? "external" : "unresolved");
---

<Base
  title="Trinity Redistricting — Ivan Minier"
  theme="editorial"
  image="/media/og/trinity.png"
  description="Case study: an independent, concept-stage housing feasibility proposal for UVM's Trinity Campus — the problem, my role, research, assumptions, alternatives, and what remains untested."
>
  <section class="civic-opening wrap-wide">
    <div>
      <p class="eyebrow">Case study · Independent student concept · 2026</p>
      <h1>
        Trinity
        <br />
        Redistricting
      </h1>
      <p class="lede">
        What could a more complete residential district look like at UVM?
      </p>
      <p>
        A concept-stage redevelopment and housing feasibility proposal that brings
        buildings, movement, preservation, and cost into one public conversation —
        and is honest about what it has not yet tested.
      </p>
      <p class="role-line">
        Originator & author · Research, planning, writing, visual direction, public site & Trinity AI
        <br />
        <span class="status">
          Independent concept · Not an official UVM or City of Burlington plan · Version {trinityRelease.version}, {trinityRelease.dateLabel}
        </span>
      </p>
    </div>
    <figure class="map-stage">
      <ProjectMedia media={p.gallery[0]} eager />
      <div class="map-key">
        <span>Housing footprints</span>
        <span>Paths & circulation</span>
        <span>Site context</span>
      </div>
      <figcaption>
        Concept district map from the public proposal. Footprints are concept-stage and
        not surveyed; they describe intent, not approved construction.
      </figcaption>
    </figure>
  </section>

  <section class="wrap-wide">
    <dl class="st-kpis" aria-label={`Version ${trinityRelease.version} baseline figures`}>
      <div><dt>Trinity Peaks</dt><dd>{F.peaksBeds}<small>beds · author assumption</small></dd></div>
      <div><dt>Trinity Rise</dt><dd>{F.riseBeds}<small>beds · author assumption</small></dd></div>
      <div><dt>Combined new</dt><dd>{F.newBeds}<small>beds · calculated</small></dd></div>
      <div><dt>Replaced</dt><dd>{F.replacedBeds.replace("about ", "≈ ")}<small>beds · needs UVM verification</small></dd></div>
      <div><dt>Net-new</dt><dd>{F.netNewBeds.replace("about ", "≈ ")}<small>beds · calculated</small></dd></div>
      <div><dt>Capital study range</dt><dd>{F.capitalRange}<small>illustrative · inclusions unresolved</small></dd></div>
    </dl>
    <p class="caption">
      Figures are read at build time from a copy of the proposal's own data file (Version {trinityRelease.version},
      {trinityRelease.dateLabel}{trinityRelease.revisedLabel ? `, revised ${trinityRelease.revisedLabel}` : ""}; trinity-site
      commit <code>{trinityPinned.short}</code>), and the build checks that copy against that pinned revision. If the
      proposal changes later, this page shows the pinned figures until it is re-synced. They are
      estimates and targets — not measured outcomes, budgets, or commitments.
    </p>
  </section>

  <section class="wrap-wide st-section">
    <span class="st-num">01 · The problem and the site</span>
    <div class="st-cols">
      <div class="st-prose">
        <h2>A large university site, an old set of halls, and a city under pressure.</h2>
        <p>
          UVM's Trinity Campus on Colchester Avenue holds McAuley, Mercy, the Cottages, and the
          five "Back Five" halls. UVM itself proposed housing there in 2022 — about 520 beds and a
          new dining hall on the roughly 21-acre site — but the City Council tabled the zoning
          change in February 2023. A 2023 draft memorandum with the City discussed up to 1,500
          new beds across three UVM parcels; its status is unconfirmed. Planned upperclass
          apartments near Centennial Woods were halted in 2024 over costs, and Catamount East is
          no longer a UVM housing option.
        </p>
        <p>
          Meanwhile Chittenden County's rental vacancy was reported at
          <a href="https://www.vermontpublic.org/local-news/2026-06-09/chittenden-county-vermont-burlington-rental-market-vacancy-rate">{tf("vacancy").text.replace(/^About/, "about")}</a>
          (Vermont Public, June 9, 2026; a county-wide landlord survey, not a student-only measure).
          The future of Trinity tends to be argued as either a rendering or a political
          position. I wanted to see whether it could be argued as a plan.
        </p>
      </div>
      <figure>
        <ProjectMedia media={p.gallery[3]} />
        <figcaption>
          The Cottages — retained for preservation and adaptive reuse in the concept.
          AI-assisted concept visualization, not a conditions survey.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="wrap-wide st-section">
    <span class="st-num">02 · Why I started it</span>
    <div class="st-cols">
      <div class="st-prose">
        <h2>The first version was visual. The useful version had to survive numbers.</h2>
        <p>
          Trinity is an independent project I originated and authored as a UVM student; no
          group, department, or client sponsors it. The first public release (May 2026) was
          mostly imagery and a video. Each later release traded some of that imagery for
          evidence: sources, status labels, bed accounting, and stated limits.
        </p>
        <blockquote class="source-excerpt">
          “A student proposal cannot approve a campus. It can make the district discussable.”
        </blockquote>
        <a class="text-link" href="/ideas/housing-as-a-system">From my project note, May 2026 ↗</a>
      </div>
      <div class="st-card">
        <h3>Objectives</h3>
        <ul>
          <li>Replace aging capacity and end reliance on forced triples.</li>
          <li>Add first- and second-year beds, and apartment-style upperclass beds if demand is shown.</li>
          <li>Keep Northside Dining at the centre of north campus.</li>
          <li>Preserve the Cottages; organize movement along one spine (Trinity Way).</li>
          <li>Make every figure traceable to a source or labelled as an assumption.</li>
        </ul>
        <h3>Audiences</h3>
        <p>UVM, the City of Burlington, current students and Trinity residents, neighbours, and planning professionals.</p>
        <h3>The ask</h3>
        <p>
          An introductory meeting and help scoping a "Phase 0" feasibility study — not adoption of
          a design, a budget, or a capital commitment. Phase 0 is requested, not commissioned.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap-wide st-section">
    <span class="st-num">03 · Existing conditions and constraints</span>
    <h2>What the site already decides.</h2>
    <div class="st-cols-3">
      <div class="st-card">
        <h3>Zoning <Chip k="external" /></h3>
        <p>
          The adopted Trinity Campus overlay, as reported
          (<a href="https://www.burlingtonvt.gov/DocumentCenter/View/6267">City ordinance, Article 4, Sec. 4.5.2(e)</a>):
          40% lot coverage (subject to its stated exception), a 115-ft Colchester Avenue buffer, and new
          construction up to the greater of 35 ft or existing structures on the same parcel, with an
          <strong>absolute {trinityCeilingFt}-ft ceiling</strong>. The 2022 recommendation of 80 ft was
          tabled, not adopted. A planner must confirm intervening amendments.
        </p>
      </div>
      <div class="st-card">
        <h3>Existing beds <Chip k="calculated" /></h3>
        <p>
          The halls the plan would replace hold about 562–567 beds: McAuley (≈160) and Mercy
          (≈182) from unverified secondary listings, plus the Back Five (5 × 44–45). UVM's designed
          bed counts would confirm it.
        </p>
      </div>
      <div class="st-card">
        <h3>Dining <Chip k="external" /></h3>
        <p>
          Northside Dining sits inside McAuley. From fall 2026 it closes early Fridays and is closed
          Saturdays. Demolishing McAuley means the dining hall must be rebuilt — and residents fed
          during construction.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap-wide st-section">
    <span class="st-num">04 · The concept, in four parts</span>
    <h2>A district, not a building.</h2>
    <div class="st-cols">
      <figure>
        <ProjectMedia media={p.gallery[1]} />
        <figcaption>
          <strong>Trinity Peaks</strong> — {F.peaksBeds} first- and second-year beds in residential
          wings of 5–6 floors over a partly sunken ground floor, with singles, doubles, suites,
          accessible rooms, top-floor duplex rooms, RA rooms, and staff apartments; designed
          without forced triples. AI-assisted concept visualization.
        </figcaption>
      </figure>
      <figure>
        <ProjectMedia media={p.gallery[2]} />
        <figcaption>
          <strong>Trinity Rise</strong> — {F.riseBeds} apartment-style beds for juniors, seniors,
          and transfer students, set deep in the site, with an {trinityRiseStoryRange}-story height target that would
          need a zoning amendment; to be built only if demand is shown. AI-assisted concept
          visualization; massing is not a tested height.
        </figcaption>
      </figure>
      <figure>
        <img src="/media/trinity/northside.webp" width="1200" height="683" alt="AI-assisted concept of a bright, expanded dining hall with long tables and a servery." loading="lazy" />
        <figcaption>
          <strong>Northside Dining</strong> — rebuilt and expanded inside Trinity Peaks between its
          north and south lobbies, as the district's food, study, and social centre. Size and
          seating are not set. AI-assisted concept visualization.
        </figcaption>
      </figure>
      <div class="st-card">
        <h3>Trinity Way + parking garage</h3>
        <p>
          One spine for walking, biking, transit, and service, and a three-level, solar-roofed
          garage off Trinity Way between Peaks and Rise, so surface lots can become open space.
          Bike and ski storage in both residential buildings supports car-light living. Garage
          capacity and solar output are not calculated.
        </p>
        <p>
          The <strong>Cottages</strong> are preserved for adaptive reuse; Northline Cafe is a
          concept-stage cafe and study node at Rise.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap-wide st-section">
    <span class="st-num">05 · What I did — and what I didn't</span>
    <h2>My contribution, separated from everyone else's.</h2>
    <div class="st-table-wrap" tabindex="0" role="region" aria-label="Contribution breakdown">
      <table class="st-table">
        <thead><tr><th scope="col">Work</th><th scope="col">Who</th><th scope="col">Nature</th></tr></thead>
        <tbody>
          <tr><td>Concept origination, program, district organization, naming</td><td>Ivan Minier</td><td>Original</td></tr>
          <tr><td>Research: UVM and City records, zoning text, news, benchmarks (48 cited sources)</td><td>Ivan Minier, with AI-assisted search and drafting</td><td>Original research, sourced</td></tr>
          <tr><td>Bed accounting, capital study allowances, scenarios, evidence ledger</td><td>Ivan Minier</td><td>Authored assumptions and calculations</td></tr>
          <tr><td>Proposal, memo, 16-slide deck, document packet with accessible companions</td><td>Ivan Minier, AI-assisted writing and layout</td><td>Original</td></tr>
          <tr><td>Renderings and aerials</td><td>Directed by Ivan Minier, generated with AI image tools</td><td><Chip k="ai" /> concept visualizations, not designs</td></tr>
          <tr><td>Diagrams (height section, phasing), district map</td><td>Ivan Minier, AI-assisted</td><td>Schematic</td></tr>
          <tr><td>Public website and Trinity AI (retrieval-augmented assistant, live source layer, logging)</td><td>Ivan Minier, AI-assisted development</td><td>Original technical work</td></tr>
          <tr><td>October 29, 2026 correction pass "after an independent audit"</td><td>Audit source to be confirmed by the author</td><td>Corrections recorded in the release history</td></tr>
          <tr><td>Engineering, surveying, zoning/legal review, cost estimating, architecture</td><td><strong>No one yet</strong></td><td>Required before any reliance</td></tr>
        </tbody>
      </table>
    </div>
    <p class="caption">
      Roles summarize the public project's own disclosures. No engineer, architect, planner, or
      cost estimator has reviewed the proposal.
    </p>
  </section>

  <section class="wrap-wide st-section">
    <span class="st-num">06 · Design direction and visual exploration</span>
    <div class="st-cols">
      <div class="st-prose">
        <h2>Calm, durable, and lived in.</h2>
        <p>
          The visual direction aims for rooms that feel functional and calm rather than luxurious:
          daylight, real common space close to bedrooms, and residential wings that act as smaller
          neighbourhoods. Peaks was revised to read as no more than six floors, tucking duplex
          rooms into a hidden seventh level. Rise was moved deep into the site, behind Peaks.
        </p>
        <p>
          Every rendering is AI-assisted and labelled that way. None shows a tested height, a floor
          plan, or a measured site. That gap is what my residential design studies, now in
          progress and not yet published, are beginning to address.
        </p>
      </div>
      <div class="st-figs">
        <figure>
          <img src="/media/trinity/peaks-bedroom.webp" width="1200" height="722" alt="AI-assisted concept of a Trinity Peaks bedroom with a large window, desk, and built-in storage." loading="lazy" />
          <figcaption>Peaks bedroom mood. AI-assisted concept visualization.</figcaption>
        </figure>
        <figure>
          <img src="/media/trinity/rise-apartments.webp" width="1200" height="725" alt="AI-assisted concept of a Trinity Rise apartment living room and kitchen." loading="lazy" />
          <figcaption>Rise apartment mood. AI-assisted concept visualization.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="wrap-wide st-section">
    <span class="st-num">07 · Research and assumptions</span>
    <div class="st-split">
      <div class="st-prose">
        <h2>Every number wears a label.</h2>
        <p>
          The proposal's figures live in one data file. Each carries a status — externally
          supported, owner-confirmed, authored assumption, calculated, scenario, or unresolved —
          and cites its sources. Pages, documents, and Trinity AI are generated from that file,
          and a build check fails if they disagree.
        </p>
        <div class="st-legend">
          <span><Chip k="external" /> documented elsewhere</span>
          <span><Chip k="assumption" /> my planning assumption</span>
          <span><Chip k="calculated" /> arithmetic from the above</span>
        </div>
      </div>
      <div class="st-table-wrap" tabindex="0" role="region" aria-label="Key figures and their status">
        <table class="st-table">
          <thead><tr><th scope="col">Figure</th><th scope="col">Value</th><th scope="col">Status</th></tr></thead>
          <tbody>
            {ledger.map((f) => (
              <tr><td>{f.label}</td><td>{f.text}</td><td><Chip k={kind(f.status)} label={statusLabel[f.status]} /></td></tr>
            ))}
          </tbody>
          <caption>Source: Trinity Redistricting data, Version {trinityRelease.version} ({trinityRelease.dateLabel}).</caption>
        </table>
      </div>
    </div>
  </section>

  <section class="wrap-wide st-section">
    <span class="st-num">08 · Capacity, cost, zoning, and feasibility questions</span>
    <h2>The questions the concept cannot answer on its own.</h2>
    <div class="st-cols">
      <ul class="st-prose">
        <li><strong>Demand.</strong> About 885–1,035 net-new first- and second-year beds is a large expansion with no enrollment growth (UVM reported undergraduate enrollment down about 7% in 2026). The case rests on removing triples, replacing aging halls, and freeing other halls — none yet quantified.</li>
        <li><strong>Height.</strong> Six visible Peaks floors may exceed {trinityCeilingFt} ft; an {trinityRiseStoryRange} story Rise certainly would. Both point to a zoning amendment the City has not granted.</li>
        <li><strong>Fit.</strong> No massing test fit, gross floor area, or room inventory exists for the proposal yet. A first schematic test fit is in progress.</li>
      </ul>
      <ul class="st-prose">
        <li><strong>Cost.</strong> The {F.capitalRange} range is an illustrative study range; soft costs, off-site utilities, escalation, financing, swing housing, and parking are not confirmed as included, and the Rise allowance was carried over from a larger concept.</li>
        <li><strong>Dining and phasing.</strong> How residents eat while McAuley comes down is unplanned.</li>
        <li><strong>Affordability.</strong> No rent is promised; Phase 0 would define total cost of occupancy against Redstone Lofts, University Commons, Spinner Place, and off-campus leases.</li>
      </ul>
    </div>
  </section>

  <section class="wrap-wide st-section">
    <span class="st-num">09 · Alternatives considered</span>
    <h2>Three releases, each narrower and more honest.</h2>
    <div class="st-table-wrap" tabindex="0" role="region" aria-label="Alternatives and versions">
      <table class="st-table">
        <thead><tr><th scope="col">Version / scenario</th><th scope="col">What changed</th><th scope="col">Why</th></tr></thead>
        <tbody>
          <tr><td>v1.1 · May 2026</td><td>1,850–2,100 beds; 1,400–1,650 net-new; Rise 400–500 beds at 8–10 stories</td><td>First public release, with video (now archived as superseded)</td></tr>
          <tr><td>v1.2 · Oct 28, 2026</td><td>Rise lowered to 6–7 stories and 300–400 beds; an unsupported 15% rental-pressure claim withdrawn</td><td>Scale back claims the evidence did not support</td></tr>
          <tr class="hl"><td>v1.3 · Oct 29–30, 2026</td><td>Replaced beds raised to ≈565 (McAuley, Mercy, Back Five demolished); net-new fell to ≈1,185–1,435; Peaks capped at six visible floors; Rise target set at 8–12 stories with beds not re-tested; Northside moved into Peaks; garage added</td><td>Correction pass after an audit, plus design decisions</td></tr>
          <tr><td>Minimum scenario</td><td>Peaks + Northside only: 1,450–1,600 beds, ≈885–1,035 net-new</td><td>Rise proceeds only if demand is shown</td></tr>
          <tr><td>Higher-bed scenario</td><td>Rise up to ≈500 beds (≈2,100 total); no cost allowance</td><td>Unapproved alternative, kept separate from the baseline</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="wrap-wide st-section">
    <span class="st-num">10 · Timeline and current status</span>
    <div class="st-cols">
      <ol class="st-timeline">
        <li><time datetime="2026-05-01">1 May 2026</time>Version 1.1 and project video published.</li>
        <li><time datetime="2026-10-28">28 Oct 2026</time>Version 1.2: smaller Rise, withdrawn claim, memo, deck, and context timeline.</li>
        <li><time datetime="2026-10-29">29–30 Oct 2026</time>Version 1.3 correction pass and design updates; Trinity AI 3.3.</li>
        <li><time datetime="2026-11-06">Nov 2026</time>Independent residential design studies begin (in progress, not yet published).</li>
      </ol>
      <div class="st-card">
        <h3>Status today</h3>
        <p>
          Version {trinityRelease.version} is published at trinityredistricting.com. It is not
          adopted, funded, or endorsed by UVM or the City. Phase 0 is requested, not commissioned.
          The 2023 MOU's status is unconfirmed.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap-wide st-section">
    <span class="st-num">11 · Lessons and what I would investigate next</span>
    <div class="st-cols">
      <div class="st-prose">
        <h2>What the project taught me.</h2>
        <ul>
          <li>An image sets expectations that numbers then have to earn. Each release removed a claim before adding a feature.</li>
          <li>Bed counts are only as good as the replacement count beneath them; one demolition decision moved net-new beds by hundreds.</li>
          <li>Height is the hinge between capacity, cost, and politics — and it has to be tested in feet, not stories.</li>
          <li>Publishing status labels with every number made the proposal easier to criticize, which made it better.</li>
        </ul>
      </div>
      <div class="st-prose">
        <h2>Next investigations.</h2>
        <ul>
          <li>UVM headcounts by class year, triple counts, and designed-bed counts by building.</li>
          <li>A surveyed site plan, parcel boundaries, and a planner's read of the overlay and height method.</li>
          <li>Room-level test fits for Peaks and Rise (in progress).</li>
          <li>A rebased Rise cost and a demand study at real prices.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section wrap-wide case-ending">
    <div>
      <span class="st-num">12 · Sources and full documentation</span>
      <h2>Open to scrutiny.</h2>
      <p>
        The public site holds the proposal, the document packet with accessible companions, the
        evidence and source ledgers, and Trinity AI.
      </p>
      <div class="actions">
        <a class="btn" href="https://trinityredistricting.com">trinityredistricting.com ↗</a>
        <a class="btn btn-ghost" href="https://trinityredistricting.com/documents.html">Documents ↗</a>
        <a class="btn btn-ghost" href="https://trinityredistricting.com/methods.html">Methods & sources ↗</a>
      </div>
    </div>
    <NextProject slug={p.slug} />
  </section>
</Base>
