---
import Base from '../../layouts/Base.astro';
import NextProject from '../../components/NextProject.astro';
import ProjectFacts from '../../components/ProjectFacts.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import { getProject } from '../../data/projects';
import { site } from '../../data/site';

const project = getProject('trinity-redistricting')!;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.name,
  description: project.summary,
  url: 'https://trinityredistricting.com',
  author: { '@type': 'Person', name: 'Ivan Minier', url: site.url },
  creator: { '@type': 'Person', name: 'Ivan Minier', url: site.url },
};
---

<Base title={`${project.name} — Ivan Minier`} description={project.summary} jsonLd={jsonLd} image="/media/og/trinity.png">
  <section class="case-hero">
    <div class="wrap">
      <div class="meta-row">
        <span class="badge">{project.statusLabel}</span>
        <span>By Ivan Minier</span>
        <span>{project.year}</span>
      </div>
      <h1>Housing relief first. Then public benefit. Then feasibility.</h1>
      <p class="lede">{project.summary}</p>
      <ProjectFacts project={project} />
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap-wide editorial">
      <ProjectMedia media={project.hero} eager />
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap">
      <div class="notice">
        <strong>Created by Ivan Minier.</strong>
        Independent student-led concept. Not an official University of Vermont or City of Burlington project.
        Figures are concept-stage targets for feasibility review, not official budgets or construction documents.
      </div>
      <div class="metrics" style="margin-top:1.2rem;">
        <div class="metric"><strong>1,850–2,100</strong><span>preferred concept beds</span></div>
        <div class="metric"><strong>1,400–1,650</strong><span>estimated net-new beds after replacement</span></div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap prose">
      <h2>The problem</h2>
      <p>{project.problem}</p>
      <h2>The approach</h2>
      <p>{project.approach}</p>
      <h2>What the vision contains</h2>
      <div class="grid-2">
        {project.capabilities.map((item) => (
          <article class="card">
            <strong>{item.title}</strong>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
      <h2>Why this shape</h2>
      <p>{project.reasoning}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap-wide gallery">
      {project.gallery.map((media) => (
        <figure class="wide">
          <div class="editorial">
            <ProjectMedia media={media} />
          </div>
          {media.caption && <figcaption>{media.caption}</figcaption>}
        </figure>
      ))}
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap">
      <div class="actions">
        {project.links.map((link) => (
          <a class="btn btn-ghost" href={link.href} rel="noopener">{link.label} ↗</a>
        ))}
      </div>
      <NextProject slug={project.slug} />
    </div>
  </section>
</Base>
