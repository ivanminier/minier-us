---
import Base from "../../layouts/Base.astro";
import ProjectMedia from "../../components/ProjectMedia.astro";
import NextProject from "../../components/NextProject.astro";
import m from "../../data/lineup-current-media.json";
import { getProject } from "../../data/projects";
const project = getProject("lineup")!;
---

<Base
  title="Lineup — Ivan Minier"
  theme="cinematic"
  image="/media/og/lineup-update.png"
  description={project.summary}
>
  <section class="lineup-opening wrap-wide">
    <div class="lineup-title">
      <div>
        <p class="eyebrow">Tideframe Labs / Television software</p>
        <h1>Lineup</h1>
      </div>
      <div>
        <p class="lede">
          Your sources.
          <br />A better way to watch.
        </p>
        <p class="role-line">
          Creator · Product, interface & engineering
          <br />
          <span class="status">
            {project.statusLabel} · {project.platforms.join(", ")}
          </span>
        </p>
      </div>
    </div>
    <div class="tv-frame">
      <ProjectMedia media={m.tv} eager sizes="(max-width:700px) 90vw, 1100px" />
    </div>
    <p class="caption">
      Apple TV store preview with a fictional catalog. Bring your own authorized sources.
    </p>
  </section>
  <section class="section wrap-wide lineup-guide">
    <div class="story-copy">
      <p class="eyebrow">01 / Make the catalog usable</p>
      <h2>
        Less decoding.
        <br />
        More watching.
      </h2>
      <p>
        A source can arrive with duplicate names, leftover categories, and guide
        data that doesn't quite fit. I built Lineup to turn that list into
        a home for live TV, movies, and series.
      </p>
      <p>
        The guide puts channels and time in one view. The original provider
        catalog stays intact while the interface becomes easier to navigate.
      </p>
      <a class="text-link" href="/ideas/messy-catalogs">
        Read the project note ↗
      </a>
    </div>
    <figure class="tablet-stage">
      <ProjectMedia media={m.guide} />
      <figcaption>
        iPad guide — a shared timeline makes the next programme easier to find.
      </figcaption>
    </figure>
  </section>
  <section class="section wrap-wide review-spread">
    <figure>
      <ProjectMedia media={m.review} />
      <figcaption>
        Smart Lineup (Pro) shows proposed changes before they’re applied.
      </figcaption>
    </figure>
    <div class="story-copy">
      <p class="eyebrow">02 / Review before applying</p>
      <h2>Organization you can inspect.</h2>
      <p>
        Smart Lineup presents duplicate streams and proposed catalog changes for review. The original entries remain available.
      </p>
      <p>
        Separate profiles give viewers their own Home layout, favorites, watchlist, and collections.
      </p>
    </div>
  </section>
  <section class="section wrap-wide">
    <div class="section-heading">
      <div>
        <p class="eyebrow">03 / Different screens, one purpose</p>
        <h2>Room to watch your way.</h2>
      </div>
    </div>
    <div class="lineup-details">
      <figure class="detail-phone">
        <ProjectMedia media={m.home} sizes="280px" />
        <figcaption>
          iPhone Home — featured artwork and Continue Watching.
        </figcaption>
      </figure>
      <figure class="detail-wide">
        <ProjectMedia media={m.multiview} />
        <figcaption>
          Multiview (Pro) on Apple TV, with four fictional feeds.
        </figcaption>
      </figure>
    </div>
    <p class="caption">
      The demo uses fictional titles, AI-generated artwork, and short original video studies.{" "}
      <a href="/media/lineup/r3/CREDITS.md">Full media credits</a>.
    </p>
  </section>
  <section class="section wrap-wide">
    <div class="section-heading">
      <div>
        <h2>Tools for the way you watch.</h2>
        <p>Signal Check shows playback diagnostics, and the Home layout adapts to a wider display.</p>
      </div>
    </div>
    <div class="lineup-details">
      <figure class="detail-phone">
        <ProjectMedia media={m.signal} sizes="280px" />
        <figcaption>Signal Check on iPhone surfaces connection and stream information.</figcaption>
      </figure>
      <figure class="detail-wide">
        <ProjectMedia media={m.duo} />
        <figcaption>Home on the inner display of an iPhone Duo simulator.</figcaption>
      </figure>
    </div>
  </section>
  <section class="section wrap-wide case-ending">
    <div>
      <h2>Lineup 1.0.</h2>
      <p>
        I submitted Lineup 1.0 for App Review on iPhone, iPad, and Apple TV.
      </p>
      <a class="btn" href={project.officialHome!.href}>
        Lineup at Tideframe Labs ↗
      </a>
    </div>
    <NextProject slug="lineup" />
  </section>
</Base>
