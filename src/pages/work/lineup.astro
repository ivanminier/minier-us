---
import Base from "../../layouts/Base.astro";
import ProjectMedia from "../../components/ProjectMedia.astro";
import NextProject from "../../components/NextProject.astro";
import m from "../../data/lineup-media.json";
import { getProject } from "../../data/projects";
const project = getProject("lineup")!;
---

<Base
  title="Lineup — Ivan Minier"
  theme="cinematic"
  image="/media/og/lineup-r3.png"
  description="Building an Apple-native player and organizer for your own television sources. Coming soon from Tideframe Labs."
>
  <section class="lineup-opening wrap-wide">
    <div class="lineup-title">
      <div>
        <p class="eyebrow">Tideframe Labs / Television software</p>
        <h1>Lineup</h1>
      </div>
      <div>
        <p class="lede">
          Your sources.
          <br />A better way to watch.
        </p>
        <p class="role-line">
          Creator · Product, interface & engineering
          <br />
          <span class="status">
            {project.statusLabel} · {project.platforms.join(", ")}
          </span>
        </p>
      </div>
    </div>
    <div class="tv-frame">
      <ProjectMedia media={m.tv} eager sizes="(max-width:700px) 90vw, 1100px" />
    </div>
    <p class="caption">
      Actual Apple TV simulator capture. Original fictional demo; Lineup
      includes no channels or subscriptions. Bring your own authorized sources.
    </p>
  </section>
  <section class="section wrap-wide lineup-guide">
    <div class="story-copy">
      <p class="eyebrow">01 / Make the catalog usable</p>
      <h2>
        Less decoding.
        <br />
        More watching.
      </h2>
      <p>
        A source can arrive with duplicate names, leftover categories, and guide
        data that doesn't quite fit. I’m building Lineup to turn that list into
        a home for Live TV, movies, and series.
      </p>
      <p>
        The guide puts channels and time in one view. The original provider
        catalog stays intact while the interface becomes easier to navigate.
      </p>
      <a class="text-link" href="/ideas/messy-catalogs">
        Read the project note ↗
      </a>
    </div>
    <figure class="tablet-stage">
      <ProjectMedia media={m.guide} />
      <figcaption>
        iPad guide — a shared timeline makes the next programme easier to find.
      </figcaption>
    </figure>
  </section>
  <section class="section wrap-wide review-spread">
    <figure>
      <ProjectMedia media={m.review} />
      <figcaption>
        Smart Lineup · Pro. A genuine Review Changes screen from the fictional
        fixture.
      </figcaption>
    </figure>
    <div class="story-copy">
      <p class="eyebrow">02 / Review before applying</p>
      <h2>Organization you can inspect.</h2>
      <p>
        Rather than silently rewriting a source, Smart Lineup presents grouped
        channels and proposed changes for review. The original entries remain
        available.
      </p>
      <p>
        The review makes each proposed change visible before it becomes part of
        the viewing experience.
      </p>
    </div>
  </section>
  <section class="section wrap-wide">
    <div class="section-heading">
      <div>
        <p class="eyebrow">03 / Different screens, one purpose</p>
        <h2>Room to watch your way.</h2>
      </div>
    </div>
    <div class="lineup-details">
      <figure class="detail-phone">
        <ProjectMedia media={m.home} sizes="280px" />
        <figcaption>
          iPhone Home — featured artwork and Continue Watching.
        </figcaption>
      </figure>
      <figure class="detail-wide">
        <ProjectMedia media={m.multiview} />
        <figcaption>
          Multiview · Pro. Four distinct original camera-motion studies in the
          approved simulator demo.
        </figcaption>
      </figure>
    </div>
    <p class="caption">
      Fictional titles and AI-generated original artwork; demo video studies are
      180 seconds, not full films or broadcasts.{" "}
      <a href="/media/lineup/r3/CREDITS.md">Full media credits</a>.
    </p>
  </section>
  <section class="section wrap-wide case-ending">
    <div>
      <h2>Still being built.</h2>
      <p>
        These screens document the current simulator build. Lineup is coming
        soon for iPhone, iPad, and Apple TV, with Mac planned.
      </p>
      <a class="btn" href="https://tideframelabs.com/lineup">
        Lineup at Tideframe Labs ↗
      </a>
    </div>
    <NextProject slug="lineup" />
  </section>
</Base>
