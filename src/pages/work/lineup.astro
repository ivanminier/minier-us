---
import Base from '../../layouts/Base.astro';
import LineupTransform from '../../components/LineupTransform.astro';
import NextProject from '../../components/NextProject.astro';
import ProjectFacts from '../../components/ProjectFacts.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import { getProject } from '../../data/projects';
import { site } from '../../data/site';

const project = getProject('lineup')!;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: project.name,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'iOS, iPadOS, tvOS',
  description: project.summary,
  creator: { '@type': 'Person', name: 'Ivan Minier', url: site.url },
  author: { '@type': 'Person', name: 'Ivan Minier', url: site.url },
  publisher: { '@type': 'Organization', name: 'Tideframe Labs', url: 'https://tideframelabs.com' },
};
---

<Base
  title={`${project.name} — Ivan Minier`}
  description={project.summary}
  jsonLd={jsonLd}
  image="/media/lineup/topshelf.webp"
  theme="cinematic"
>
  <section class="case-hero">
    <div class="wrap">
      <div class="meta-row">
        <span class="badge">{project.statusLabel}</span>
        <span>{project.studioLabel}</span>
        <span>{project.year}</span>
      </div>
      <h1>{project.oneLiner}</h1>
      <p class="lede">{project.summary}</p>
      <ProjectFacts project={project} />
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap-wide cinematic lineup-stage">
      <div class="device-phone">
        <ProjectMedia media={project.hero} eager />
      </div>
      <img
        src="/media/lineup/topshelf.webp"
        srcset="/media/lineup/topshelf-sm.webp 800w, /media/lineup/topshelf.webp 1600w"
        width="1600"
        height="480"
        alt="Lineup mark on a wide Apple TV top-shelf banner."
      />
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap">
      <p class="kicker">Lineup Intelligence</p>
      <h2>Playback is table stakes. The catalog is the product.</h2>
      <p class="lede">Provider names, categories, logos, and guide data arrive as a pile. Lineup Intelligence derives a television lineup without rewriting the source.</p>
      <LineupTransform />
      <p class="caption" style="margin-top:0.8rem;">
        Illustrative names only. Lineup organizes catalogs supplied by the person using it.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap prose">
      <h2>The pile</h2>
      <p>{project.problem}</p>
      <h2>What Lineup keeps vs. what it shows</h2>
      <p>{project.approach}</p>
      <h2>What it can do</h2>
      <div class="grid-2">
        {project.capabilities.map((item) => (
          <article class="card">
            <strong>{item.title}</strong>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
      <h2>Why this shape</h2>
      <p>{project.reasoning}</p>
      <p>{project.platformsNote}</p>
      <p>Lineup is not an IPTV service. It does not sell channels or host streams.</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap-wide gallery">
      {project.gallery.map((media) => (
        <figure>
          <div class="device-phone">
            <ProjectMedia media={media} />
          </div>
        </figure>
      ))}
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap">
      <div class="actions">
        {project.links.map((link) => (
          <a class="btn btn-ghost" href={link.href} rel={link.external ? 'noopener' : undefined}>
            {link.label}{link.external ? ' ↗' : ''}
          </a>
        ))}
      </div>
      <NextProject slug={project.slug} />
    </div>
  </section>
</Base>
