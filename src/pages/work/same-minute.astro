---
import Base from "../../layouts/Base.astro";
import ProjectMedia from "../../components/ProjectMedia.astro";
import NextProject from "../../components/NextProject.astro";
import media from "../../data/same-minute-media.json";
import { getProject } from "../../data/projects";

const project = getProject("same-minute")!;
const gallery = [
  { media: media.solo, caption: "Solo mode starts with a timer ready to go." },
  { media: media.break, caption: "When an interval ends, you choose when to start your break." },
  { media: media.watch, caption: "The countdown and controls on Apple Watch." },
];
---

<Base
  title="Same Minute — Ivan Minier"
  theme="paper"
  image="/media/og/same-minute.png"
  description={project.summary}
>
  <section class="same-minute-opening wrap-wide">
    <div>
      <img src={project.icon} width="72" height="72" alt="" class="same-minute-icon" />
      <p class="eyebrow">Tideframe Labs / Focus timer</p>
      <h1>Same Minute</h1>
      <p class="lede">A focus timer for two.</p>
      <p>{project.oneLiner}</p>
      <p class="role-line">
        Creator · Product, interface & engineering
        <br />
        <span class="status">{project.platforms.join(", ")}</span>
      </p>
      <a class="btn" href={project.officialHome!.href}>Download on the App Store</a>
    </div>
    <figure class="same-minute-stage">
      <ProjectMedia media={media.together} eager sizes="(max-width:700px) 240px, 310px" />
      <figcaption>Together mode on iPhone.</figcaption>
    </figure>
  </section>
  <section class="section wrap-wide same-minute-story">
    <div class="story-copy">
      <h2>Working together from different cities.</h2>
      <p>{project.problem}</p>
      <p>{project.approach}</p>
      <p>Together requires iCloud for both participants. The solo timer works offline.</p>
    </div>
    <figure>
      <ProjectMedia media={media.ipad} sizes="(max-width:700px) 85vw, 440px" />
      <figcaption>The same shared session on iPad.</figcaption>
    </figure>
  </section>
  <section class="section wrap-wide">
    <h2>A place to start and a place to pause.</h2>
    <div class="project-screenshot-grid">
      {gallery.map((shot) => (
        <figure>
          <ProjectMedia media={shot.media} sizes="(max-width:700px) 210px, 250px" />
          <figcaption>{shot.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>
  <section class="section wrap-wide case-ending">
    <div>
      <h2>Try Same Minute.</h2>
      <a class="text-link" href={project.links[0].href}>More at Tideframe Labs</a>
    </div>
    <NextProject slug={project.slug} />
  </section>
</Base>
