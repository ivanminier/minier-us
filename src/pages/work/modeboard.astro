---
import Base from "../../layouts/Base.astro";
import ProjectMedia from "../../components/ProjectMedia.astro";
import NextProject from "../../components/NextProject.astro";
import { getProject } from "../../data/projects";
const p = getProject("modeboard")!;
---

<Base
  title="Modeboard — Ivan Minier"
  theme="mac"
  image="/media/og/modeboard.png"
  description={p.summary}
>
  <section class="mac-opening wrap-wide">
    <div class="instrument-head">
      <div>
        <p class="instrument-label">Tideframe Labs / macOS utility</p>
        <h1>Modeboard</h1>
      </div>
      <div>
        <p class="lede">
          Give each part of your day
          <br />a workspace of its own.
        </p>
        <p class="role-line">
          Creator · Product, interface & engineering
          <br />
          <span class="status">{p.statusLabel}</span>
        </p>
      </div>
    </div>
    <figure class="mac-stage">
      <ProjectMedia
        media={p.hero}
        eager
        sizes="(max-width:700px) 90vw, 1100px"
      />
      <figcaption>
        Actual app window — a profile brings supported workspace settings into
        one place.
      </figcaption>
    </figure>
  </section>
  <section class="section wrap-wide sequence">
    <article>
      <p class="instrument-label">01 / Define a profile</p>
      <h2>A named setup.</h2>
      <p>
        Study, work, or a quieter desktop: collect the apps, files, appearance,
        and supported settings that belong together.
      </p>
    </article>
    <article>
      <p class="instrument-label">02 / Apply a change</p>
      <h2>One deliberate switch.</h2>
      <p>
        Apply a profile from the app, menu bar, Shortcuts, or a Focus Filter.
        macOS owns the Focus; Modeboard supplies the workspace.
      </p>
    </article>
    <article>
      <p class="instrument-label">03 / Keep a way back</p>
      <h2>Restore supported settings.</h2>
      <p>
        Verified backups precede relevant changes. Restore and Emergency Restore
        provide a path back for supported settings.
      </p>
    </article>
  </section>
  <section class="section wrap-wide mac-restore">
    <figure>
      <ProjectMedia media={p.gallery.find((x) => x.src.includes("backups"))!} />
      <figcaption>
        The real Backups & Restore interface. A backup is part of the workflow.
      </figcaption>
    </figure>
    <div>
      <p class="instrument-label">Designing for confidence</p>
      <h2>
        Control needs
        <br />a way back.
      </h2>
      <p>
        Workspace changes can affect a lot of familiar details at once. I made
        the profile and backup states explicit so a small utility does not feel
        like a mysterious system tweak.
      </p>
      <p>
        The scope stays specific: restore applies to supported settings, with
        backup history visible in the app.
      </p>
    </div>
  </section>
  <section class="section wrap-wide case-ending">
    <div>
      <h2>A focused Mac utility.</h2>
      <p>
        Product details, licensing, downloads, and support live at Tideframe
        Labs.
      </p>
      <a class="btn" href="https://tideframelabs.com/modeboard">
        Modeboard at Tideframe Labs ↗
      </a>
    </div>
    <NextProject slug={p.slug} />
  </section>
</Base>
