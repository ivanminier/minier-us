---
import Base from "../../layouts/Base.astro";
import ProjectMedia from "../../components/ProjectMedia.astro";
import NextProject from "../../components/NextProject.astro";
import media from "../../data/rental-record-media.json";
import { getProject } from "../../data/projects";

const project = getProject("rental-record")!;
---

<Base title="Rental Record — Ivan Minier" theme="paper" image="/media/og/rental-record-update.png" description={project.summary}>
  <section class="wrap-wide rental-intro">
    <div>
      <p class="eyebrow">Tideframe Labs / Rental documentation</p>
      <h1>Rental Record</h1>
      <p class="lede">Make a record you can come back to.</p>
      <p>
        It’s easy to take photos during a move and forget where they belong.
        I built Rental Record so the room, condition, observation, and photo
        stay together all the way to the report.
      </p>
      <p class="role-line">
        Creator · Product, interface & engineering<br />
        <span class="status">{project.statusLabel} · {project.platforms.join(", ")}</span>
      </p>
      <div class="actions">
        <a class="btn" href={project.officialHome!.href}>View on the App Store</a>
        <a class="text-link" href="/ideas/a-record-you-can-read">Read the design note</a>
      </div>
    </div>
    <figure class="rental-capture rental-cases">
      <ProjectMedia media={media.cases} eager sizes="220px" />
      <figcaption>The Cases view, using a fictional Maple Street rental.</figcaption>
    </figure>
  </section>

  <section class="section wrap-wide rental-workflow">
    <div>
      <h2>Start with the room.</h2>
      <p>
        A room gives each observation an address inside the rental. You can come
        back to the living room months later and still know which photos show
        the space as a whole and which show a specific issue.
      </p>
      <p>
        I structured the checklist around the order of a walkthrough. Set the
        scene with a wide photo, add a close-up where it tells you something, and
        write the detail the image can’t show. A follow-up or move-out
        inspection gives those earlier observations a place to be compared.
      </p>
      <p>
        A handoff has its own information too. Meters, keys, and access devices
        belong in the rental record so you can find them alongside the
        inspection.
      </p>
    </div>
    <figure class="rental-capture rental-evidence">
      <ProjectMedia media={media.evidence} sizes="190px" />
      <figcaption>A photo and its condition notes stay attached to the inspection.</figcaption>
    </figure>
  </section>

  <section class="section wrap-wide rental-output">
    <div>
      <h2>End with a report someone else can read.</h2>
      <p>
        I wanted an export to make sense without the app open. The PDF follows
        the rooms from the walkthrough, and you can review it before sharing.
        Rental Record can also export an evidence package when you need the
        supporting files together.
      </p>
      <p>
        The record stays on your device, with optional iCloud backup. You
        decide when to export and who gets a copy.
      </p>
      <a class="text-link" href="https://tideframelabs.com/products/rental-record/reports/rental-record-fictional-sample.pdf">Read the fictional sample PDF</a>
    </div>
    <figure class="rental-capture rental-mac">
      <ProjectMedia media={media.report} sizes="(max-width:700px) 80vw, 460px" />
      <figcaption>The report preview on Mac. Open the image to inspect the full app window.</figcaption>
    </figure>
  </section>

  <section class="section wrap-wide rental-update">
    <div>
      <h2>Editing as the record changes.</h2>
      <p>
        In the 1.2.1 preview, a space can be edited as the inspection evolves.
        Lease dates, deposit details, and property contacts can be updated from
        the rental record. Apple currently lists version 1.2 as Tideframe Rental Record.
      </p>
    </div>
    <a class="text-link" href={project.links[1].href}>More at Tideframe Labs</a>
  </section>

  <section class="section wrap-wide case-ending">
    <div>
      <h2>Try Rental Record.</h2>
      <a class="text-link" href={project.officialHome!.href}>Download on the App Store</a>
    </div>
    <NextProject slug={project.slug} />
  </section>
</Base>

<style>
  .rental-intro,
  .rental-workflow,
  .rental-output,
  .rental-update {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 6vw, 5rem);
  }
  .rental-intro {
    padding-block: clamp(2.5rem, 5vw, 5rem);
  }
  .rental-intro h1 {
    font-size: clamp(2.75rem, 6vw, 5.4rem);
  }
  .rental-intro .actions {
    margin-top: 1.4rem;
  }
  .rental-intro p,
  .rental-workflow p,
  .rental-output p,
  .rental-update p {
    max-width: 56ch;
  }
  .rental-workflow,
  .rental-output,
  .rental-update {
    border-top: 1px solid var(--line);
  }
  .rental-capture {
    display: grid;
    place-items: center;
    gap: 0.6rem;
    padding: clamp(1rem, 2.5vw, 1.75rem);
    background: var(--panel);
    border: 1px solid var(--line);
    text-align: center;
  }
  .rental-cases :global(.image-link) {
    width: min(100%, 198px);
  }
  .rental-evidence :global(.image-link) {
    width: min(100%, 150px);
  }
  .rental-mac :global(.image-link) {
    width: min(100%, 460px);
  }
  @media (max-width: 700px) {
    .rental-intro,
    .rental-workflow,
    .rental-output,
    .rental-update {
      grid-template-columns: minmax(0, 1fr);
    }
    .rental-cases :global(.image-link) {
      width: min(100%, 165px);
    }
  }
</style>
