---
import Base from '../../layouts/Base.astro';
import NextProject from '../../components/NextProject.astro';
import ProjectFacts from '../../components/ProjectFacts.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import { getProject } from '../../data/projects';
import { site } from '../../data/site';

const project = getProject('rental-record')!;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: project.name,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'iOS, iPadOS, macOS',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
  url: 'https://apps.apple.com/us/app/tideframe-rental-record/id6796366130',
  description: project.summary,
  creator: { '@type': 'Person', name: 'Ivan Minier', url: site.url },
  author: { '@type': 'Person', name: 'Ivan Minier', url: site.url },
  publisher: { '@type': 'Organization', name: 'Tideframe Labs', url: 'https://tideframelabs.com' },
};
---

<Base title={`${project.name} — Ivan Minier`} description={project.summary} jsonLd={jsonLd} image="/media/og/rental-record.png" theme="paper">
  <section class="case-hero" style={`--page-accent:${project.accent}`}>
    <div class="wrap">
      <div class="meta-row">
        <span class="badge">{project.statusLabel}</span>
        <span>{project.studioLabel}</span>
        <span>{project.year}</span>
      </div>
      <h1>Document your rental clearly.</h1>
      <p class="lede">{project.summary}</p>
      <ProjectFacts project={project} />
      <div class="actions">
        {project.links.map((link) => (
          <a class="btn" href={link.href} rel="noopener">{link.label} ↗</a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap-wide devices-row">
      <div class="device-phone">
        <ProjectMedia media={project.hero} sizes="260px" eager />
      </div>
      <div class="device-tablet">
        <ProjectMedia media={project.devices!.tablet!} sizes="(max-width: 900px) min(420px, 92vw), 420px" />
      </div>
      <div class="shot">
        <ProjectMedia media={project.devices!.desktop!} sizes="(max-width: 900px) 92vw, 47vw" />
      </div>
    </div>
    <p class="wrap-wide caption" style="margin-top:1rem;">
      The same case on iPhone, iPad, and Mac. All rental data shown is fictional.
    </p>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap prose">
      <h2>The problem</h2>
      <p>{project.problem}</p>
      <h2>The approach</h2>
      <p>{project.approach}</p>
      <h2>What it does</h2>
      <div class="grid-2">
        {project.capabilities.map((item) => (
          <article class="card">
            <strong>{item.title}</strong>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
      <h2>Why this shape</h2>
      <p>{project.reasoning}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap-wide gallery">
      {project.gallery.map((media) => (
        <figure class={media.presentation === 'screen' ? 'wide' : undefined}>
          {media.presentation === 'device' && (
            <div class="device-phone"><ProjectMedia media={media} /></div>
          )}
          {media.presentation === 'tablet' && (
            <div class="device-tablet"><ProjectMedia media={media} /></div>
          )}
          {media.presentation === 'screen' && (
            <div class="shot"><ProjectMedia media={media} /></div>
          )}
          {media.caption && <figcaption>{media.caption}</figcaption>}
        </figure>
      ))}
    </div>
  </section>

  <section class="section" style="padding-top:0;">
    <div class="wrap">
      <NextProject slug={project.slug} />
    </div>
  </section>
</Base>
