---
const before = [
  { raw: 'USA | HARBOR-NEWS HD', group: 'USA HD', extra: 'no logo' },
  { raw: 'VIP-US | meridian_world', group: 'INTL??', extra: 'no guide' },
  { raw: 'US MOVIES ABC 1080', group: 'VOD / MIX', extra: 'wrong bin' },
  { raw: 'espn usa east fhd', group: 'SPORT', extra: 'dup stream' },
  { raw: 'BBCWORLD-NEWS-UK', group: 'news_us', extra: 'bad country' },
  { raw: 'MTVHits_HE', group: 'MISC', extra: 'noise suffix' },
];

const after = [
  { name: 'Harbor News', group: 'News', extra: 'logo + guide' },
  { name: 'Meridian World', group: 'News', extra: 'matched' },
  { name: 'ABC', group: 'Movies', extra: 'recategorized' },
  { name: 'ESPN', group: 'Sports', extra: 'primary stream' },
  { name: 'BBC World News', group: 'News', extra: 'normalized' },
  { name: 'MTV Hits', group: 'Music', extra: 'cleaned' },
];
---

<section class="transform" aria-label="How Lineup Intelligence organizes a messy catalog">
  <div class="transform-col before">
    <p class="kicker">Raw provider</p>
    <strong>What arrives</strong>
    <ul>
      {
        before.map((row) => (
          <li>
            <span>{row.raw}</span>
            <span>{row.group} · {row.extra}</span>
          </li>
        ))
      }
    </ul>
  </div>
  <p class="arrow">Lineup Intelligence</p>
  <div class="transform-col after">
    <p class="kicker">Television</p>
    <strong>What you watch</strong>
    <ul>
      {
        after.map((row) => (
          <li>
            <strong>{row.name}</strong>
            <span>{row.group} · {row.extra}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
