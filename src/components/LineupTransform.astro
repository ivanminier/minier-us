---
/*
 * Fictional channel names only, matching the demo catalog shown in the real
 * screenshots elsewhere on this page (Harbor News, Meridian World, Aurora
 * Sports, Daybreak 24). No real broadcaster names belong in an illustrative
 * before/after.
 */
const before = [
  { raw: 'USA | HARBOR_NEWS-HD', group: 'USA HD', extra: 'no logo' },
  { raw: 'VIP-US | meridian.world_24-7', group: 'INTL??', extra: 'no guide' },
  { raw: 'US SPORT aurora-sports fhd', group: 'SPORT', extra: 'dup stream' },
  { raw: 'D2_Daybreak-24_backup', group: 'news_us', extra: 'bad country' },
  { raw: 'stadium row (east) HD', group: 'MISC', extra: 'wrong bin' },
  { raw: 'CourtsideOneUS_HE', group: 'MISC', extra: 'noise suffix' },
];

const after = [
  { name: 'Harbor News', group: 'News', extra: 'logo + guide' },
  { name: 'Meridian World', group: 'News', extra: 'matched' },
  { name: 'Aurora Sports', group: 'Sports', extra: 'primary stream' },
  { name: 'Daybreak 24', group: 'News', extra: 'normalized' },
  { name: 'Stadium Row', group: 'Sports', extra: 'recategorized' },
  { name: 'Courtside One', group: 'Sports', extra: 'cleaned' },
];
---

<section class="transform" aria-label="How Lineup Intelligence organizes a messy catalog">
  <div class="transform-col before">
    <p class="kicker">Raw provider</p>
    <strong>What arrives</strong>
    <ul>
      {
        before.map((row) => (
          <li>
            <span>{row.raw}</span>
            <span>{row.group} · {row.extra}</span>
          </li>
        ))
      }
    </ul>
  </div>
  <p class="arrow">Lineup Intelligence</p>
  <div class="transform-col after">
    <p class="kicker">Television</p>
    <strong>What you watch</strong>
    <ul>
      {
        after.map((row) => (
          <li>
            <strong>{row.name}</strong>
            <span>{row.group} · {row.extra}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
