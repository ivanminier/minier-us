---
import { getProject } from "../data/projects";
import rental from "../data/rental-record-media.json";
import sameMinute from "../data/same-minute-media.json";
import ProjectMedia from "./ProjectMedia.astro";

interface Props {
  slug: string;
  featured?: boolean;
}

const { slug, featured = false } = Astro.props;
const project = getProject(slug)!;
const secondary = slug === "same-minute" ? sameMinute.watch
  : slug === "rental-record" ? rental.report
  : undefined;
---

<article class:list={["work-card", slug, { featured }]}>
  <a class="work-art" href={project.href} aria-label={`Explore ${project.name}`}>
    <div class:list={["work-shots", { paired: secondary }]}>
      <div class="work-shot">
        <ProjectMedia media={project.hero} zoom={false} sizes={secondary ? "180px" : "(max-width:700px) 85vw, 45vw"} />
      </div>
      {secondary && (
        <div class="work-shot">
          <ProjectMedia media={secondary} zoom={false} sizes={slug === "same-minute" ? "110px" : "380px"} />
        </div>
      )}
    </div>
  </a>
  <div class="work-caption">
    <div>
      <h3><a href={project.href}>{project.shortName}</a></h3>
      <p>{project.category} · {project.statusLabel}</p>
      <p class="card-description">{project.oneLiner}</p>
    </div>
  </div>
</article>
