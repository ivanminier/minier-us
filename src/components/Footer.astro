---
import { nav, site } from "../data/site";
import { socials } from "../data/socials";
---

<footer class="footer wrap-wide">
  <div class="footer-top">
    <a class="footer-name" href="/">
      Ivan Minier<span>Vermont · Communication, design & software</span>
    </a>
    <a href="mailto:ivan@minier.us">ivan@minier.us ↗</a>
  </div>
  <div class="footer-bottom">
    <span>
      © {new Date().getFullYear()} {site.name}
    </span>
    <nav aria-label="Footer">
      {nav.map((x) => (
        <a href={x.href}>{x.label}</a>
      ))}
      <a href="/tideframe">Studio</a>
      <a href="/ideas">Notes</a>
    </nav>
    <div class="social-links">
      {socials.map((x) => (
        <a href={x.href} rel="me noopener">
          {x.label}
        </a>
      ))}
    </div>
  </div>
</footer>
