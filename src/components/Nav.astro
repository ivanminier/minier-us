---
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="nav-inner">
    <a class="brand" href="/">
      <span class="brand-word">{site.name}</span>
    </a>
    <nav class="nav-links" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={path === item.href || (item.href !== '/' && path.startsWith(item.href)) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <button class="icon-btn theme-btn" type="button" data-theme-toggle aria-pressed="false" aria-label="Switch to dark mode">
        <svg class="theme-sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.75"></circle>
          <path d="M12 3v2M12 19v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M3 12h2M19 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
        </svg>
        <svg class="theme-moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M16.5 13.2A6.5 6.5 0 0 1 10.8 7.4 6.6 6.6 0 1 0 16.5 13.2Z" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"></path>
        </svg>
      </button>
    </nav>
    <button class="icon-btn menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
      Menu
    </button>
  </div>
</header>
<div class="mobile-panel" id="mobile-nav" data-open="false" hidden>
  {
    nav.map((item) => (
      <a href={item.href} data-menu-link>{item.label}</a>
    ))
  }
  <button class="icon-btn theme-btn" type="button" data-theme-toggle aria-label="Switch to dark mode">
    Theme
  </button>
</div>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('#mobile-nav');
  // `offsetParent` is unreliable inside a fixed-position panel — in WebKit it can
  // be null for visible children, which emptied this list and let Tab escape the
  // open menu into the page behind it. Client rects are consistent everywhere.
  const focusables = () =>
    panel
      ? [...panel.querySelectorAll<HTMLElement>('a, button, [tabindex]:not([tabindex="-1"])')].filter(
          (el) => !el.hasAttribute('disabled') && el.getClientRects().length > 0,
        )
      : [];
  const setOpen = (open: boolean, moveFocus = true) => {
    if (!panel || !toggle) return;
    panel.dataset.open = String(open);
    panel.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.textContent = open ? 'Close' : 'Menu';
    document.body.style.overflow = open ? 'hidden' : '';
    if (!moveFocus) return;
    if (open) {
      focusables()[0]?.focus();
    } else {
      toggle.focus();
    }
  };
  toggle?.addEventListener('click', () => setOpen(panel?.dataset.open !== 'true'));
  // The panel is hidden by CSS above 900px, but the body scroll lock is not.
  // Opening the menu on a phone and then rotating or resizing past the
  // breakpoint left the page unscrollable with the toggle still reading "Close".
  const desktop = window.matchMedia('(min-width: 901px)');
  const closeOnDesktop = () => {
    if (desktop.matches && panel?.dataset.open === 'true') setOpen(false, false);
  };
  desktop.addEventListener('change', closeOnDesktop);
  panel?.querySelectorAll('[data-menu-link]').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });
  document.addEventListener('keydown', (event) => {
    if (panel?.dataset.open !== 'true') return;
    if (event.key === 'Escape') {
      setOpen(false);
      return;
    }
    if (event.key !== 'Tab') return;
    const items = [toggle, ...focusables()].filter((el): el is HTMLElement => Boolean(el));
    if (!items.length) return;
    // Drive the whole cycle rather than only intercepting at the two ends.
    // Relying on native sequential focus let Tab escape the open panel in
    // WebKit, which then bounced between the skip link and the close button.
    event.preventDefault();
    const index = items.indexOf(document.activeElement as HTMLElement);
    const step = event.shiftKey ? -1 : 1;
    const next = index === -1 ? (event.shiftKey ? items.length - 1 : 0) : (index + step + items.length) % items.length;
    items[next].focus();
  });
</script>
